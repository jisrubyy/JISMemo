<Window x:Class="JISMemo.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JISMemo 도움말" Height="500" Width="600" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="JISMemo 도움말" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <TextBlock x:Name="HelpContentText" TextWrapping="Wrap" FontSize="14" LineHeight="20"/>
            
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="프로그램 정보" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding VersionInfo}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            
            <Button x:Name="OkButton" Content="확인" Width="80" Height="30" Margin="0,20,0,0" Click="OkButton_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>